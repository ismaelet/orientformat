{
    frankenphp
    order php_server before file_server
}

:80 {
    encode zstd gzip

    root * /var/www/html/public

    redir /orientamento /orientamento/

    handle_path /orientamento/* {
        vars rewritten_uri {uri}

        php_server {
            env REQUEST_URI {vars.rewritten_uri}
        }
    }

    handle {
        php_server
    }
}