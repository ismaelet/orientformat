name: orientformat
services:
    app:
        build:
            context: .
            dockerfile: docker/app/Dockerfile
        volumes:
            - './app:/app'
        ports:
            - '8000:8000'
        command: php artisan serve --host=0.0.0.0 --port=8000
        environment:
            APP_ENV: production
            APP_KEY: base64:qHm4aJFRisc/saISzf1uVA3A0p/LU4l93f9ImxjQslA=
            APP_DEBUG: true
            DB_CONNECTION: mysql
            DB_HOST: database
            DB_PORT: 3306
            DB_DATABASE: project_database
            DB_USERNAME: root
            DB_PASSWORD: rootpassword
            SENTRY_LARAVEL_DSN: https://e447b3e2e461e53f94a481211bfe795a@o4507159757717504.ingest.de.sentry.io/4507193373556816
            SENTRY_TRACES_SAMPLE_RATE: 0
        depends_on:
            - database
    database:
        image: 'mysql:5.7.40'
        ports:
            - '3306:3306'
        environment:
            MYSQL_DATABASE: project_database
            MYSQL_ROOT_PASSWORD: rootpassword
        volumes:
            - 'database:/var/lib/mysql'
volumes:
    database:
        driver: local
