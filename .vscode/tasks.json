{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Artisan: Migrate",
			"type": "shell",
			"command": "docker",
			"args": ["exec", "laravel", "php", "artisan", "migrate"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Artisan: Rollback",
			"type": "shell",
			"command": "docker",
			"args": ["exec", "laravel", "php", "artisan", "migrate:rollback"],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Artisan: Run Tests",
			"type": "shell",
			"command": "docker",
			"args": ["exec", "laravel", "php", "artisan", "test"],
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Get Route List",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "route:list"],
			"group": {
				"kind": "test",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Make Controller",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "make:controller", "${input:name}Controller"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Make Migration",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "make:migration", "${input:name}"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Make Model",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "make:model", "${input:name}"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Make Test",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "make:test", "${input:name}Test"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		},
		{
			"label": "Artisan: Make View",
			"type": "shell",
			"command": "php",
			"args": ["artisan", "make:view", "${input:name}"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"reveal": "always"
			}
		}
	],
	"inputs": [
		{
			"id": "name",
			"type": "promptString",
			"description": "Enter the name here"
		}
	]
}
