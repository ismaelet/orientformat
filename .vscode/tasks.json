{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "migrate",
			"type": "shell",
			"command": "sed -i 's/MIGRATE=.*/MIGRATE=true/; s/ROLLBACK=.*/ROLLBACK=false/' .env",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "rollback",
			"type": "shell",
			"command": "sed -i 's/MIGRATE=.*/MIGRATE=false/; s/ROLLBACK=.*/ROLLBACK=true/' .env",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "newMigration",
			"command": "touch ./database/migrations/`date +%Y_%m_%d_%H:%M`_${input:fileName}.php",
			"type": "shell",
			"problemMatcher": [],
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"promptOnClose": false
		}
	],
	"inputs": [
		{
			"type": "promptString",
			"id": "fileName",
			"description": "Complete my file name.",
			"default": "create_" // make your default text here
		}
	]
}
