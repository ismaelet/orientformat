{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OrientFormat: Access server",
      "type": "shell",
      "command": "sshpass -f ~/.ssh/orientformat-password ssh -t orientformat 'cd /products/software/docker/orientamentoformativo && exec bash -l'",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "close": false
      }
    },
    {
      "label": "OrientFormat: Deploy in production",
      "type": "shell",
      "command": "sshpass -f ~/.ssh/orientformat-password ssh -t orientformat 'cd /products/software/docker/orientamentoformativo && /usr/bin/docker-compose-wrapper.sh -f production-compose.yml up -d --build'",
      "problemMatcher": []
    },
    {
      "label": "OrientFormat: Migrate in production",
      "type": "shell",
      "command": "sshpass -f ~/.ssh/orientformat-password ssh orientformat 'cd /products/software/docker/orientamentoformativo && /usr/bin/docker-compose-wrapper.sh -f production-compose.yml exec -T app php artisan migrate --force'",
      "problemMatcher": []
    },
    {
      "label": "OrientFormat: Test Pest",
      "type": "shell",
      "command": "cd app && pnpm test:pest",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "OrientFormat: Test All",
      "dependsOn": ["OrientFormat: Test Pest", "Test: Vitest", "Test: Playwright"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
